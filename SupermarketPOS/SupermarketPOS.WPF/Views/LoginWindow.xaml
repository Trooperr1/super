<Window x:Class="SupermarketPOS.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="چوونەژوورەوە - سیستەمی POS"
        Height="500" Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        FlowDirection="RightToLeft">

    <Border Background="White"
            CornerRadius="10"
            BorderBrush="{DynamicResource PrimaryHueMidBrush}"
            BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30"
                            Direction="0"
                            ShadowDepth="0"
                            Opacity="0.3"
                            Color="{DynamicResource Primary}"/>
        </Border.Effect>

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- لۆگۆ - Logo -->
            <materialDesign:PackIcon Grid.Row="0"
                                   Kind="Store"
                                   Width="80"
                                   Height="80"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}"
                                   Margin="0,0,0,20"/>

            <!-- سەردێڕ - Title -->
            <TextBlock Grid.Row="1"
                      Text="سیستەمی POS"
                      FontSize="28"
                      FontWeight="Bold"
                      HorizontalAlignment="Center"
                      Foreground="{DynamicResource PrimaryHueMidBrush}"
                      Margin="0,0,0,10"/>

            <TextBlock Grid.Row="2"
                      Text="سوپەرمارکێتی هیوا"
                      FontSize="16"
                      HorizontalAlignment="Center"
                      Foreground="Gray"
                      Margin="0,0,0,30"/>

            <!-- ناوی بەکارهێنەر - Username -->
            <TextBox Grid.Row="3"
                    Name="UsernameTextBox"
                    materialDesign:HintAssist.Hint="ناوی بەکارهێنەر"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Margin="0,0,0,20"
                    FontSize="16"
                    Padding="10"/>

            <!-- وشەی نهێنی - Password -->
            <PasswordBox Grid.Row="4"
                        Name="PasswordBox"
                        materialDesign:HintAssist.Hint="وشەی نهێنی"
                        Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                        Margin="0,0,0,20"
                        FontSize="16"
                        Padding="10"/>

            <!-- دوگمەی چوونەژوورەوە - Login Button -->
            <Button Grid.Row="5"
                   Content="چوونەژوورەوە"
                   Click="LoginButton_Click"
                   Style="{StaticResource MaterialDesignRaisedButton}"
                   Height="45"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

            <!-- زانیاری سەرەتایی - Default Credentials -->
            <StackPanel Grid.Row="6"
                       VerticalAlignment="Bottom"
                       Margin="0,20,0,0">
                <TextBlock Text="بەکارهێنەری سەرەتایی:"
                          FontSize="12"
                          Foreground="Gray"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="ناوی بەکارهێنەر: admin | وشەی نهێنی: admin123"
                          FontSize="11"
                          Foreground="Gray"
                          HorizontalAlignment="Center"
                          Margin="0,5,0,0"/>
                <TextBlock Text="کاشێر: cashier | وشەی نهێنی: cashier123"
                          FontSize="11"
                          Foreground="Gray"
                          HorizontalAlignment="Center"
                          Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
