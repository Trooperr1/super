<Window x:Class="SupermarketPOS.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سیستەمی POS - سوپەرمارکێتی هیوا"
        Height="900" Width="1600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <!-- Fallback styles in case MaterialDesign isn't loaded -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- شریتی سەرەوە - Top Bar -->
        <Border Grid.Row="0"
                Background="#673AB7"
                Padding="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- لۆگۆ و ناو - Logo and Name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Viewbox Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Canvas Width="24" Height="24">
                            <Path Fill="White" Data="M12,18H6V14H12M21,14V12L20,7H4L3,12V14H4V20H14V14H18V20H20V14M20,4H4V6H20V4Z"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="سیستەمی POS - سوپەرمارکێتی هیوا"
                              FontSize="20"
                              FontWeight="Bold"
                              Foreground="White"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <!-- زانیاری بەکارهێنەر - User Info -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Viewbox Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Canvas Width="24" Height="24">
                            <Path Fill="White" Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Name="UserNameTextBlock"
                              Text="بەکارهێنەر"
                              FontSize="16"
                              Foreground="White"
                              VerticalAlignment="Center"
                              Margin="0,0,20,0"/>
                    <Button Content="چوونەدەرەوە"
                           Click="LogoutButton_Click"
                           Foreground="White"
                           Background="Transparent"
                           BorderThickness="1"
                           BorderBrush="White"
                           Padding="15,8"
                           Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                   BorderThickness="{TemplateBinding BorderThickness}"
                                                   BorderBrush="{TemplateBinding BorderBrush}"
                                                   CornerRadius="4"
                                                   Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#7E57C2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ناوەڕۆک - Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- مێنیوی لا - Side Menu -->
            <Border Grid.Column="0"
                   Background="#F5F5F5"
                   BorderBrush="#E0E0E0"
                   BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,0">

                        <!-- داشبۆرد - Dashboard -->
                        <Button Name="DashboardButton"
                               Click="MenuButton_Click"
                               Tag="Dashboard"
                               Style="{StaticResource MenuButtonStyle}"
                               Margin="5">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="24" Height="24" Margin="0,0,15,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#673AB7" Data="M13,3V9H21V3M13,21H21V11H13M3,21H11V15H3M3,13H11V3H3V13Z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="داشبۆرد" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- فرۆشتن/کاشێر - Sales/POS -->
                        <Button Name="POSButton"
                               Click="MenuButton_Click"
                               Tag="POS"
                               Style="{StaticResource MenuButtonStyle}"
                               Margin="5">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="24" Height="24" Margin="0,0,15,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#673AB7" Data="M2,17H22V21H2V17M6.25,7H9V6H6V3H14V6H11V7H17.8C18.8,7 19.8,8 19.8,9C19.8,10 18.8,11 17.8,11H16.2C15.2,11 14.2,10 14.2,9C14.2,8.66 14.32,8.36 14.5,8.1L11,8.1V15H13V17H7V15H9V8.1H7.5C7.66,8.36 7.8,8.66 7.8,9C7.8,10 6.8,11 5.8,11H4.2C3.2,11 2.2,10 2.2,9C2.2,8 3.2,7 4.2,7H6.25M4.2,9.75C4.61,9.75 4.95,9.41 4.95,9C4.95,8.59 4.61,8.25 4.2,8.25C3.79,8.25 3.45,8.59 3.45,9C3.45,9.41 3.79,9.75 4.2,9.75M16.2,9.75C16.61,9.75 16.95,9.41 16.95,9C16.95,8.59 16.61,8.25 16.2,8.25C15.79,8.25 15.45,8.59 15.45,9C15.45,9.41 15.79,9.75 16.2,9.75Z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="فرۆشتن - کاشێر" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- بەڕێوەبردنی مەخزەن - Inventory -->
                        <Button Name="InventoryButton"
                               Click="MenuButton_Click"
                               Tag="Inventory"
                               Style="{StaticResource MenuButtonStyle}"
                               Margin="5">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="24" Height="24" Margin="0,0,15,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#673AB7" Data="M21,16.5C21,16.88 20.79,17.21 20.47,17.38L12.57,21.82C12.41,21.94 12.21,22 12,22C11.79,22 11.59,21.94 11.43,21.82L3.53,17.38C3.21,17.21 3,16.88 3,16.5V7.5C3,7.12 3.21,6.79 3.53,6.62L11.43,2.18C11.59,2.06 11.79,2 12,2C12.21,2 12.41,2.06 12.57,2.18L20.47,6.62C20.79,6.79 21,7.12 21,7.5V16.5M12,4.15L6.04,7.5L12,10.85L17.96,7.5L12,4.15M5,15.91L11,19.29V12.58L5,9.21V15.91M19,15.91V9.21L13,12.58V19.29L19,15.91Z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="بەڕێوەبردنی مەخزەن" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- کڕیارەکان - Customers -->
                        <Button Name="CustomersButton"
                               Click="MenuButton_Click"
                               Tag="Customers"
                               Style="{StaticResource MenuButtonStyle}"
                               Margin="5">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="24" Height="24" Margin="0,0,15,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#673AB7" Data="M16,13C15.71,13 15.38,13 15.03,13.05C16.19,13.89 17,15 17,16.5V19H23V16.5C23,14.17 18.33,13 16,13M8,13C5.67,13 1,14.17 1,16.5V19H15V16.5C15,14.17 10.33,13 8,13M8,11A3,3 0 0,0 11,8A3,3 0 0,0 8,5A3,3 0 0,0 5,8A3,3 0 0,0 8,11M16,11A3,3 0 0,0 19,8A3,3 0 0,0 16,5A3,3 0 0,0 13,8A3,3 0 0,0 16,11Z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="کڕیارەکان" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- ڕاپۆرتەکان - Reports -->
                        <Button Name="ReportsButton"
                               Click="MenuButton_Click"
                               Tag="Reports"
                               Style="{StaticResource MenuButtonStyle}"
                               Margin="5">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="24" Height="24" Margin="0,0,15,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#673AB7" Data="M22,21H2V3H4V19H6V10H10V19H12V6H16V19H18V14H22V21Z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="ڕاپۆرتەکان" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Separator Margin="10,10" Background="#E0E0E0"/>

                        <!-- ڕێکخستنەکان - Settings -->
                        <Button Name="SettingsButton"
                               Click="MenuButton_Click"
                               Tag="Settings"
                               Style="{StaticResource MenuButtonStyle}"
                               Margin="5">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="24" Height="24" Margin="0,0,15,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#673AB7" Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="ڕێکخستنەکان" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ناوەڕۆکی سەرەکی - Main Content Area -->
            <Border Grid.Column="1" Background="White">
                <Frame Name="MainFrame"
                      NavigationUIVisibility="Hidden"
                      Background="Transparent"/>
            </Border>
        </Grid>

        <!-- شریتی خوارەوە - Status Bar -->
        <Border Grid.Row="2"
                Background="#E1BEE7"
                Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Name="StatusTextBlock"
                          Text="ئامادە"
                          VerticalAlignment="Center"
                          Foreground="#4A148C"/>

                <TextBlock Grid.Column="1"
                          Name="DateTimeTextBlock"
                          VerticalAlignment="Center"
                          FontWeight="Bold"
                          Foreground="#4A148C"/>
            </Grid>
        </Border>
    </Grid>
</Window>
